# Database Configuration (Neon PostgreSQL)
# Format: postgresql://user:password@host/database
DATABASE_URL=postgresql://xxxxx:xxxxx@ep-xxxxx.us-east-2.aws.neon.tech/neondb

# Mapbox (for geocoding hospital addresses)
# Get your token at: https://account.mapbox.com/access-tokens/
# Note: Use a SECRET token for backend (not NEXT_PUBLIC_* token)
MAPBOX_TOKEN=pk.eyJ1Ijoiexxxxx...

# Error Tracking (Optional)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Environment
ENVIRONMENT=development  # development | production

# Logging
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
