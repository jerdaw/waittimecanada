# Database Configuration (Neon PostgreSQL)
# Format: postgresql://user@host/database (include a password if your provider requires it)
DATABASE_URL=postgresql://user@ep-xxxxx.us-east-2.aws.neon.tech/neondb

# Mapbox (for geocoding hospital addresses)
# Get your token at: https://account.mapbox.com/access-tokens/
# Note: Use a non-public token for backend (not a NEXT_PUBLIC_* token)
MAPBOX_TOKEN=your_mapbox_token_here

# Error Tracking (Optional)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Environment
ENVIRONMENT=development  # development | production

# Logging
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
