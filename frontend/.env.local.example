# Database (Neon PostgreSQL)
# Copy from backend/.env.local
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://xxxxx:xxxxx@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Mapbox
# Get your token at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoiexxxxx...

# Analytics (Optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=xxxxx

# Sentry (Optional)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
