# Database Configuration (PostgreSQL)
# Format: postgresql://host:port/database
DATABASE_URL=postgresql://localhost:5432/waittimecanada

# Mapbox (for geocoding hospital addresses)
# Get your token at: https://account.mapbox.com/access-tokens/
# Note: Use a non-public token for backend (not a NEXT_PUBLIC_* token)
MAPBOX_TOKEN=your_mapbox_token_here

# Error Tracking (Optional)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Environment
ENVIRONMENT=development  # development | production

# Logging
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# Heartbeat / alerting
HEARTBEAT_STALE_THRESHOLD_MINUTES=250
ALERT_API_URL=https://alerts.example.invalid/messages
ALERT_USER_KEY=your_alert_user_key_here
ALERT_API_TOKEN=your_alert_api_token_here
ALERTS_ENABLED=false
ALERTS_REFERENCE_URL=https://github.com/jerdaw/waittimecanada/actions
OPERATIONAL_NOTIFICATION_MODE=normal  # normal | critical_only

# Optional shared Playwright browser cache path for scheduled browser jobs
# PLAYWRIGHT_BROWSERS_PATH=/tmp/waittime-playwright-browsers
