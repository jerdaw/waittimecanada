[Unit]
Description=Wait Time Canada backend database cleanup
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/projects-merge/env/waittime-backend.env
ConditionPathExists=/srv/apps/waittime-backend/current/backend/.venv/bin/python

[Service]
Type=oneshot
User=__WAITTIME_USER__
Group=__WAITTIME_GROUP__
WorkingDirectory=/srv/apps/waittime-backend/current/backend
EnvironmentFile=/etc/projects-merge/env/waittime-backend.env
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=30m
ExecStart=/srv/apps/waittime-backend/current/backend/.venv/bin/python -m waittime.cli.cleanup
