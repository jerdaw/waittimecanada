# Wait Time Canada - Frontend Environment Variables
# Copy this to .env.local and fill in your values

# Canonical public base URL (used for sitemap/robots/metadata)
NEXT_PUBLIC_BASE_URL=https://wait-time.ca

# Mapbox API Token (required for map display)
# Get yours at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# PostgreSQL connection string (required for API routes)
# Format: postgresql://host:5432/database
DATABASE_URL=postgresql://localhost:5432/waittimecanada

# Optional database SSL mode override for server-side API routes.
# Leave unset for automatic local-disable / remote-require behavior.
# DATABASE_SSL_MODE=require
