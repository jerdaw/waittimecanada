# WaitTime Canada - Frontend Environment Variables
# Copy this to .env.local and fill in your values

# Mapbox API Token (required for map display)
# Get yours at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Neon PostgreSQL Connection String (required for API routes)
# Format: postgresql://username:password@host/database?sslmode=require
# Get yours from: https://console.neon.tech/
DATABASE_URL=postgresql://username:password@ep-something.region.aws.neon.tech/neondb?sslmode=require
