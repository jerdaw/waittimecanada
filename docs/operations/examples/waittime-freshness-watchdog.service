# Copy/adapt example only. Replace WorkingDirectory and ExecStart paths in
# private operations before enabling this service.

[Unit]
Description=Wait Time Canada freshness watchdog
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/waittimecanada
EnvironmentFile=/etc/waittime/freshness.env
ExecStart=/usr/bin/python3 /opt/waittimecanada/scripts/waittime-freshness-runner.py watchdog
