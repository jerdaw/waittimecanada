[Unit]
Description=Wait Time Canada daily quality snapshot
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/projects-merge/env/waittime-backend.env
ConditionPathExists=/srv/apps/waittime-backend/current/backend/.venv/bin/python

[Service]
Type=oneshot
User=__WAITTIME_USER__
Group=__WAITTIME_GROUP__
WorkingDirectory=/srv/apps/waittime-backend/current/backend
EnvironmentFile=/etc/projects-merge/env/waittime-backend.env
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
ExecStart=/srv/apps/waittime-backend/current/backend/.venv/bin/python -m waittime.cli.snapshot_quality
ExecStartPost=-/srv/apps/waittime-backend/current/backend/.venv/bin/python /srv/apps/waittime-backend/current/backend/scripts/monitor_drift.py
